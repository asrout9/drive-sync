<UserControl x:Class="DriveSync.App.Views.CloudAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Cloud Accounts &amp; Integrations" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Connect multiple Microsoft OneDrive and Google Drive accounts with OAuth tokens stored securely in Windows DPAPI." FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="+ Connect OneDrive" Command="{Binding AddOneDriveAccountCommand}" Background="#0284C7" Foreground="White" BorderThickness="0" Height="36" Padding="14,0" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="+ Connect Google Drive" Command="{Binding AddGoogleDriveAccountCommand}" Background="#16A34A" Foreground="White" BorderThickness="0" Height="36" Padding="14,0" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- DPAPI Security Info Banner -->
        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="🔒 SECURE CREDENTIAL STORAGE (WINDOWS DPAPI)" FontWeight="Bold" FontSize="11" Foreground="#10B981"/>
                <TextBlock Text="All OAuth tokens are encrypted using Windows Data Protection API (DPAPI) keyed directly to your active Windows account. Tokens are never stored in plain text and cannot be decrypted by any other user or process on this machine." FontSize="12" Foreground="#CBD5E1" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Accounts List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Accounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="15" Foreground="#F8FAFC"/>
                                    <TextBlock Text="{Binding Email}" FontSize="12" Foreground="#38BDF8" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding LastRefreshedUtc, StringFormat='Token refreshed: {0:u}'}" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="Disconnect Account"
                                        Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="#7F1D1D" Foreground="#FCA5A5" BorderThickness="0" Height="32" Padding="12,0" VerticalAlignment="Center" Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
