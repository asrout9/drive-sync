<UserControl x:Class="DriveSync.App.Views.NewPairWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="New Two-Way Sync Pair Wizard" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
            <TextBlock Text="Configure bidirectional synchronization with automatic version preservation and conflict detection." FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Step Indicator -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="14,10" Margin="0,0,0,20" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Background="#0284C7" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Source Folder" Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Background="#0284C7" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Destination (SSD/Cloud)" Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border Background="#0284C7" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                        <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Safety Policies" Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Border Background="#0284C7" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                        <TextBlock Text="4" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Preview &amp; Confirm" Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Step Content Area -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- STEP 1: Source Selection -->
                <Border Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Pair Name" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding PairName, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="10" Height="40" FontSize="13" Margin="0,0,0,16"/>

                        <TextBlock Text="Select Source Location" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="10" Height="40" FontSize="13" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse Folder..." Command="{Binding BrowseSourceFolderCommand}" Background="#334155" Foreground="White" BorderThickness="0" Height="40" Padding="16,0" Cursor="Hand"/>
                        </Grid>

                        <TextBlock Text="Source Display Label" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SourceDisplayName, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="10" Height="36" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- STEP 2: Destination Selection -->
                <Border Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Select Destination Location (External SSD / Cloud / Folder)" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8"/>

                        <!-- Detected SSDs list if available -->
                        <TextBlock Text="Detected Removable SSDs:" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding AvailableSsds}" SelectedItem="{Binding SelectedSsd}" Background="#0F172A" Foreground="#000000" BorderBrush="#334155" Height="40" Margin="0,0,0,14">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾 "/>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text=" — "/>
                                        <TextBlock Text="{Binding FormattedSize}"/>
                                        <TextBlock Text=" ("/>
                                        <TextBlock Text="{Binding FormattedFreeSpace}"/>
                                        <TextBlock Text=")"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding DestPath, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="10" Height="40" FontSize="13" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse Folder..." Command="{Binding BrowseDestFolderCommand}" Background="#334155" Foreground="White" BorderThickness="0" Height="40" Padding="16,0" Cursor="Hand"/>
                        </Grid>

                        <TextBlock Text="Destination Display Label" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding DestDisplayName, UpdateSourceTrigger=PropertyChanged}" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" Padding="10" Height="36" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- STEP 3: Direction Explanation & Safety Policies -->
                <Border Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Two-Way Direction Banner -->
                        <Border Background="#0369A1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="TWO-WAY SYNCHRONIZATION ACTIVE" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Changes, renames, and deletions made in ANY configured location will propagate to the other locations. The external SSD remains standard and directly usable in File Explorer." FontSize="12" Foreground="#E0F2FE" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Safety Policies &amp; Retention" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12"/>

                        <!-- Deletion Policy -->
                        <TextBlock Text="Deletion Policy (What happens when a file is deleted):" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                        <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="✓ Move to Recoverable Dated 'Deleted Items' area (Recommended default)" FontWeight="SemiBold" Foreground="#10B981" FontSize="12"/>
                                <TextBlock Text="Deleted files are safely relocated to .drivesync/deleted/ for instant recovery, preventing accidental data loss." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Conflict Policy -->
                        <TextBlock Text="Conflict Policy (When both sides modify a file concurrently):" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                        <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="✓ Manual Review (Recommended safety rule)" FontWeight="SemiBold" Foreground="#F59E0B" FontSize="12"/>
                                <TextBlock Text="DriveSync will never silently overwrite conflicting edits. You will be prompted to choose: Keep Source, Keep Destination, or Keep Both with renamed copies." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Live Sync Toggle -->
                        <CheckBox IsChecked="{Binding EnableRealTimeWatcher}" Content="Enable real-time change detection watcher (instant synchronization)" Foreground="#F8FAFC" Margin="0,6,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- STEP 4: Pre-Sync Comparison & Confirmation -->
                <Border Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Pre-Sync Comparison &amp; Initial Confirmation" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                        <TextBlock Text="Simulates the two-way merge before making any changes to verify files, safety rules, and available space." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,12"/>
                        
                        <!-- Action Button -->
                        <Button Command="{Binding RunPreSyncComparisonCommand}" 
                                IsEnabled="{Binding IsComparing, Converter={StaticResource InverseBool}}"
                                Background="#0284C7" Foreground="White" BorderThickness="0" Height="38" Padding="18,0" Cursor="Hand" Margin="0,0,0,14" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍 " FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Analyze Pre-Sync Preview" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ACTIVE SCANNING PROGRESS INDICATOR -->
                        <Border Background="#0F172A" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="#0284C7" BorderThickness="1"
                                Visibility="{Binding IsComparing, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏳ " FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ComparisonStatus}" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#0369A1" CornerRadius="4" Padding="8,2">
                                        <TextBlock Text="ANALYZING..." FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                                
                                <ProgressBar IsIndeterminate="True" Height="6" Foreground="#38BDF8" Background="#1E293B" BorderThickness="0"/>
                                <TextBlock Text="Scanning directory trees, calculating checksums, and verifying two-way safety rules without modifying files." FontSize="11" Foreground="#64748B" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- COMPLETED RESULTS & METRICS BREAKDOWN -->
                        <Border Background="#0F172A" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1"
                                Visibility="{Binding ComparisonSummary, Converter={StaticResource StringNotEmptyToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ComparisonSummary}" FontSize="13" Foreground="#F8FAFC" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                <!-- Plan Metrics Pills -->
                                <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,6"
                                        Visibility="{Binding HasPreviewPlan, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="NEW FILES" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding PreviewPlan.NewFilesCount}" FontSize="20" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="MODIFICATIONS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding PreviewPlan.ChangedFilesCount}" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="DELETIONS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding PreviewPlan.DeletedFilesCount}" FontSize="20" FontWeight="Bold" Foreground="#F87171" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="CONFLICTS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding PreviewPlan.ConflictsCount}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Mandatory explicit confirmation -->
                        <Border Background="#450A0A" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="MANDATORY CONFIRMATION BEFORE FIRST SYNC" FontWeight="Bold" FontSize="12" Foreground="#FCA5A5"/>
                                <CheckBox IsChecked="{Binding HasConfirmedFirstSync}" Content="I understand that DriveSync is a two-way synchronization tool. Changes and configured deletions in either location will propagate bidirectionally. I authorize initial synchronization." Foreground="#FEE2E2" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Run Initial Sync Option -->
                        <CheckBox IsChecked="{Binding RunInitialSyncNow}" Content="Execute initial synchronization &amp; backup immediately upon activation" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,16"/>

                        <!-- ACTIVE INITIAL BACKUP PROGRESS INDICATOR -->
                        <Border Background="#0F172A" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="#0284C7" BorderThickness="1"
                                Visibility="{Binding IsExecutingInitialSync, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄 " FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding InitialSyncStatus}" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#0369A1" CornerRadius="4" Padding="8,2">
                                        <TextBlock Text="BACKING UP / SYNCING" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                                
                                <TextBlock Text="{Binding InitialSyncProgressText}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8"
                                           Visibility="{Binding InitialSyncProgressText, Converter={StaticResource StringNotEmptyToVis}}"/>
                                
                                <Grid>
                                    <ProgressBar IsIndeterminate="True" Height="7" Foreground="#38BDF8" Background="#1E293B" BorderThickness="0"
                                                 Visibility="{Binding IsIndeterminateInitialSync, Converter={StaticResource BoolToVis}}"/>
                                    <ProgressBar Height="7" Value="{Binding InitialSyncProgress}" Maximum="100" Foreground="#0EA5E9" Background="#1E293B" BorderThickness="0"
                                                 Visibility="{Binding IsIndeterminateInitialSync, Converter={StaticResource InverseBoolToVis}}"/>
                                </Grid>
                                <TextBlock Text="Safely transferring files, preserving revision snapshots, and propagating two-way changes." FontSize="11" Foreground="#64748B" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- INITIAL BACKUP COMPLETED CARD -->
                        <Border Background="#064E3B" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="#10B981" BorderThickness="1"
                                Visibility="{Binding HasCompletedInitialSyncSuccess, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="✓ Initial Backup &amp; Synchronization Completed" FontSize="14" FontWeight="Bold" Foreground="#A7F3D0"/>
                                    <TextBlock Text="{Binding InitialSyncResultSummary}" FontSize="12" Foreground="#D1FAE5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="View Sync Pairs ➔" Command="{Binding FinishWizardCommand}" Background="#10B981" Foreground="#064E3B" FontWeight="Bold" BorderThickness="0" Height="36" Padding="18,0" Cursor="Hand" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Activation Button -->
                        <Button Content="Confirm and Activate Sync Pair" Command="{Binding ConfirmAndSavePairCommand}" 
                                IsEnabled="{Binding IsExecutingInitialSync, Converter={StaticResource InverseBool}}"
                                Visibility="{Binding HasCompletedInitialSyncSuccess, Converter={StaticResource InverseBoolToVis}}"
                                Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" Height="44" Padding="24,0" Cursor="Hand" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
