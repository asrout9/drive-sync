<UserControl x:Class="DriveSync.App.Views.SsdManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="External SSD Detection &amp; Security" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="DriveSync robustly identifies external drives using hardware serials and volume tokens, preventing drive-letter mismatch errors." FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="↻ Scan For Drives" Command="{Binding RefreshDrivesCommand}" Background="#0284C7" Foreground="White" BorderThickness="0" Height="36" Padding="16,0" Cursor="Hand"/>
        </Grid>

        <!-- Security & Integrity Guidance Banner -->
        <Border Grid.Row="1" Background="#0C4A6E" CornerRadius="10" BorderBrush="#0284C7" BorderThickness="1" Padding="16" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="🛡️ EXTERNAL SSD SAFETY &amp; ENCRYPTION RECOMMENDATION" FontWeight="Bold" FontSize="12" Foreground="#38BDF8"/>
                <TextBlock Text="1. DriveSync NEVER reformats, cleans, or silently erases any external drive. Your SSD always remains a normal Windows volume usable in File Explorer." FontSize="12" Foreground="#E0F2FE" Margin="0,4,0,2" TextWrapping="Wrap"/>
                <TextBlock Text="2. If you remove your SSD during operation, DriveSync immediately pauses synchronization safely. Missing drives are NEVER treated as file deletion commands." FontSize="12" Foreground="#E0F2FE" Margin="0,0,0,2" TextWrapping="Wrap"/>
                <TextBlock Text="3. We strongly recommend enabling Windows BitLocker To Go encryption on your external SSD to safeguard sensitive data in case of loss or theft. Store your recovery keys securely in a separate location." FontSize="12" Foreground="#BAE6FD" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Drives List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding DetectedDrives}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="20" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Icon + Name + Drive Letter -->
                                    <Grid Grid.Row="0" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="💾" FontSize="24" Margin="0,0,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                <TextBlock Text="{Binding DeviceModel}" FontSize="12" Foreground="#94A3B8"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="#0F172A" CornerRadius="6" Padding="12,6" BorderBrush="#334155" BorderThickness="1">
                                            <TextBlock Text="{Binding FormattedFreeSpace}" FontWeight="SemiBold" FontSize="12" Foreground="#10B981"/>
                                        </Border>
                                    </Grid>

                                    <!-- Details Grid -->
                                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#1E293B" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="VOLUME SERIAL NUMBER" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding VolumeSerialNumber, TargetNullValue='Unknown'}" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="DRIVESYNC TOKEN (.drivesync/drive.id)" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding DriveSyncToken, TargetNullValue='Not Initialized'}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="BITLOCKER ENCRYPTION" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding IsBitLockerEncrypted, TargetNullValue='Not Protected'}" FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Bottom: Actions -->
                                    <Grid Grid.Row="2">
                                        <Button Content="Initialize Persistent DriveSync Token"
                                                Command="{Binding DataContext.InitializeTokenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#334155" Foreground="White" BorderThickness="0" Height="34" Padding="16,0" HorizontalAlignment="Right" Cursor="Hand"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
