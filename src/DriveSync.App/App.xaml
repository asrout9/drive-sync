<Application x:Class="DriveSync.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DriveSync.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
            <conv:InverseBooleanConverter x:Key="InverseBool" />
            <conv:FormatBytesConverter x:Key="FormatBytes" />
            <conv:ArchiveTypeConverter x:Key="ArchiveType" />

            <SolidColorBrush x:Key="AppBackground" Color="#0F172A"/>
            <SolidColorBrush x:Key="CardBackground" Color="#1E293B"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
            <SolidColorBrush x:Key="AccentBlue" Color="#0284C7"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
