<UserControl x:Class="DriveSync.App.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Recovery &amp; Version History" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="DriveSync preserves previous file versions before overwriting or deleting. Recover deleted files or restore prior revisions anytime." FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="🧹 Enforce Retention Cleanup" Command="{Binding RunRetentionCleanupCommand}" Background="#7F1D1D" Foreground="#FCA5A5" BorderThickness="0" Height="36" Padding="14,0" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="↻ Refresh" Command="{Binding RefreshCommand}" Background="#334155" Foreground="White" BorderThickness="0" Height="36" Padding="14,0" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Storage Breakdown Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Active Sync Data Card -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Padding="16" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ACTIVE SYNC CONTENT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding StorageUsage.ContentSizeBytes, StringFormat='{}{0} bytes'}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,2"/>
                    <TextBlock Text="Active synchronized files" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Preserved Versions Card -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="10" Padding="16" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="PRESERVED VERSIONS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding StorageUsage.PreservedVersionsCount, StringFormat='{}{0} revisions'}" FontSize="18" FontWeight="Bold" Foreground="#A855F7" Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding StorageUsage.VersionHistorySizeBytes, StringFormat='Storage: {0} bytes'}" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <!-- Recoverable Deleted Items Card -->
            <Border Grid.Column="4" Background="#1E293B" CornerRadius="10" Padding="16" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="RECOVERABLE DELETED ITEMS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding StorageUsage.DeletedItemsCount, StringFormat='{}{0} items'}" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding StorageUsage.DeletedItemsSizeBytes, StringFormat='Storage: {0} bytes'}" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Recoverable Items Table -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="RECOVERABLE ARCHIVE ENTRIES" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Restore Selected Item..." Command="{Binding RestoreItemCommand}" Background="#16A34A" Foreground="White" BorderThickness="0" Height="32" Padding="14,0" Cursor="Hand"/>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding RecoverableItems}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" HeadersVisibility="Column">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="4"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#334155"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding IsDeletedItem, Converter={StaticResource ArchiveType}}" Width="120"/>
                        <DataGridTextColumn Header="Archive Name / Relative Path" Binding="{Binding RelativePath}" Width="*"/>
                        <DataGridTextColumn Header="Archived Date" Binding="{Binding ArchivedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="150"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, StringFormat='{}{0} B'}" Width="100"/>
                        <DataGridTextColumn Header="Full Archive Path" Binding="{Binding ArchiveFullPath}" Width="250"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
