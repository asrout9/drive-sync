<Window x:Class="DriveSync.App.Views.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DriveSync Tray"
        Width="380" Height="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="Window_Deactivated">

    <Border Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DriveSync" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <Border Margin="8,0,0,0" Background="#0EA5E9" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="Two-Way" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="Close_Click" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="14" Cursor="Hand"/>
            </Grid>

            <!-- Status Banner -->
            <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="StatusTitle" Text="All locations up to date" FontWeight="SemiBold" FontSize="13" Foreground="#10B981"/>
                    <TextBlock x:Name="StatusSubtitle" Text="Last synchronized: Just now" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Sync Activity / Progress -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ACTIVE SYNC PROGRESS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                    
                    <ProgressBar x:Name="TrayProgressBar" Height="6" Value="0" Maximum="100" Margin="0,0,0,8" Foreground="#0EA5E9" Background="#334155"/>
                    <TextBlock x:Name="ProgressDescription" Text="No active transfer in progress." FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Text="CONFIGURED PAIRS" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="PairsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F172A" CornerRadius="6" Padding="8" Margin="0,0,0,6" BorderBrush="#1E293B" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#F8FAFC"/>
                                            <TextBlock Text="{Binding LastSyncSummary, TargetNullValue='Ready for sync'}" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Actions -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Open DriveSync" Click="OpenApp_Click" Background="#2563EB" Foreground="White" BorderThickness="0" Height="36" Cursor="Hand"/>
                <Button Grid.Column="2" x:Name="PauseResumeBtn" Content="Pause All" Click="PauseResume_Click" Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Height="36" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>
