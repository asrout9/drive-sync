<UserControl x:Class="DriveSync.App.Views.ConflictsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Conflict Detection &amp; Resolution Hub" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="DriveSync never silently overwrites conflicting edits. Review differing versions and choose your explicit resolution." FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="↻ Refresh" Command="{Binding RefreshCommand}" Background="#334155" Foreground="White" BorderThickness="0" Height="36" Padding="16,0" Cursor="Hand"/>
        </Grid>

        <!-- Status Message -->
        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8"/>
        </Border>

        <!-- Conflicts Layout -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Conflicts List -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="12">
                <ListBox ItemsSource="{Binding UnresolvedConflicts}" SelectedItem="{Binding SelectedConflict}" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding RelativePath}" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC"/>
                                    <TextBlock Text="{Binding ConflictReason}" FontSize="11" Foreground="#F59E0B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding DetectedTimeUtc, StringFormat='Detected: {0:g}'}" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Conflict Detail & Resolution Options -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Side-by-Side Version Comparison" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,16"/>

                        <!-- Comparison Cards -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Source Card -->
                            <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="SOURCE VERSION" FontWeight="Bold" FontSize="11" Foreground="#38BDF8"/>
                                    <TextBlock Text="{Binding SelectedConflict.RelativePath}" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" Margin="0,4,0,8"/>
                                    <TextBlock Text="{Binding SelectedConflict.SourceItem.SizeBytes, StringFormat='Size: {0} bytes'}" FontSize="12" Foreground="#CBD5E1"/>
                                    <TextBlock Text="{Binding SelectedConflict.SourceItem.LastModifiedUtc, StringFormat='Modified: {0:u}'}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding SelectedConflict.SourceItem.ContentHashSha256, StringFormat='SHA-256: {0}'}" FontSize="10" Foreground="#64748B" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Destination Card -->
                            <Border Grid.Column="2" Background="#0F172A" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="DESTINATION VERSION" FontWeight="Bold" FontSize="11" Foreground="#38BDF8"/>
                                    <TextBlock Text="{Binding SelectedConflict.RelativePath}" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" Margin="0,4,0,8"/>
                                    <TextBlock Text="{Binding SelectedConflict.DestinationItem.SizeBytes, StringFormat='Size: {0} bytes'}" FontSize="12" Foreground="#CBD5E1"/>
                                    <TextBlock Text="{Binding SelectedConflict.DestinationItem.LastModifiedUtc, StringFormat='Modified: {0:u}'}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding SelectedConflict.DestinationItem.ContentHashSha256, StringFormat='SHA-256: {0}'}" FontSize="10" Foreground="#64748B" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Last Common Version -->
                        <Border Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,0,0,24" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="LAST COMMON SYNCHRONIZED VERSION (BASE)" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SelectedConflict.BaseSnapshot.LastSyncedUtc, StringFormat='Last synced together: {0:u}'}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding SelectedConflict.BaseSnapshot.SizeBytes, StringFormat='Original size: {0} bytes'}" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- Explicit Resolution Options -->
                        <TextBlock Text="Explicit Resolution Actions:" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Keep Source Version" Command="{Binding KeepSourceCommand}" Background="#0284C7" Foreground="White" BorderThickness="0" Height="40" Padding="16,0" Margin="0,0,10,0" Cursor="Hand"/>
                            <Button Content="Keep Destination Version" Command="{Binding KeepDestinationCommand}" Background="#0D9488" Foreground="White" BorderThickness="0" Height="40" Padding="16,0" Margin="0,0,10,0" Cursor="Hand"/>
                            <Button Content="Keep Both (With Renamed Copy)" Command="{Binding KeepBothCommand}" Background="#4F46E5" Foreground="White" BorderThickness="0" Height="40" Padding="16,0" Cursor="Hand"/>
                        </StackPanel>

                        <TextBlock Text="Note: Choosing any resolution automatically archives the prior version in version recovery before overwriting or deleting." FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
