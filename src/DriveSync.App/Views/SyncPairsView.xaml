<UserControl x:Class="DriveSync.App.Views.SyncPairsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Synchronized Folder Pairs" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Changes made in any configured location propagate to all other configured locations." FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="↻ Refresh" Command="{Binding RefreshCommand}" Background="#334155" Foreground="White" BorderThickness="0" Height="36" Padding="16,0" Cursor="Hand"/>
        </Grid>

        <!-- Status / Progress notification -->
        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <ProgressBar Height="4" Value="{Binding CurrentProgress}" Maximum="100" Margin="0,6,0,0" Foreground="#0EA5E9"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pairs List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Empty state -->
                <Border Background="#0F172A" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1" Padding="40" HorizontalAlignment="Center" Margin="0,40,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Pairs.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="No Sync Pairs Configured Yet" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                        <TextBlock Text="Create your first two-way sync pair between your local folders, external SSD, or cloud drive." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,16" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Cards collection -->
                <ItemsControl ItemsSource="{Binding Pairs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="18" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Name + Direction Badge + Status -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            <Border Background="#0284C7" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                <TextBlock Text="TWO-WAY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <Border Background="#7C3AED" CornerRadius="4" Padding="6,2" Margin="6,0,0,0"
                                                    Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="PAUSED" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="#0F172A" CornerRadius="6" Padding="10,4" BorderBrush="#334155" BorderThickness="1">
                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8"/>
                                        </Border>
                                    </Grid>

                                    <!-- Middle Row: Endpoints Flow Visualizer -->
                                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#1E293B" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Source Endpoint -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="SOURCE LOCATION" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Source.DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Source.RootPath}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Direction Indicator -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0" HorizontalAlignment="Center">
                                                <TextBlock Text="⇄" FontSize="20" Foreground="#0EA5E9" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Two-Way" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Destination Endpoint -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="DESTINATION LOCATION" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Destination.DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Destination.RootPath}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Bottom Row: Meta Info & Actions -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LastSyncSummary, TargetNullValue='No sync performed yet'}" FontSize="12" Foreground="#CBD5E1"/>
                                            <TextBlock Text="{Binding DirectionDescription}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Sync Now"
                                                    Command="{Binding DataContext.SyncNowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#0284C7" Foreground="White" BorderThickness="0" Height="32" Padding="12,0" Margin="0,0,6,0" Cursor="Hand"/>
                                            <Button Content="Dry Run"
                                                    Command="{Binding DataContext.DryRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Height="32" Padding="12,0" Margin="0,0,6,0" Cursor="Hand"/>
                                            <Button Content="Pause / Resume"
                                                    Command="{Binding DataContext.TogglePauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#1E293B" Foreground="#94A3B8" BorderBrush="#475569" BorderThickness="1" Height="32" Padding="10,0" Margin="0,0,6,0" Cursor="Hand"/>
                                            <Button Content="Remove"
                                                    Command="{Binding DataContext.DeletePairCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#7F1D1D" Foreground="#FCA5A5" BorderThickness="0" Height="32" Padding="10,0" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
